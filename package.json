{
  "name": "sage",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:down": "docker compose down",
    "build": "npm run build -w packages/shared && npm run build -w packages/server && npm run build -w packages/client && node scripts/postbuild.mjs",
    "start": "node packages/server/dist/index.js",
    "migrate": "node packages/server/dist/db/migrate.js",
    "worker": "node packages/server/dist/jobs/worker.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
