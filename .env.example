# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sage

# Session
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-32-random-bytes

# Encryption key for API keys stored in DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SAGE_ENC_KEY=change-me-to-32-random-bytes-base64

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3001/auth/github/callback

# Default LLM provider + model (used when user has no saved setting)
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini

# Optional: env-var API key fallbacks (used when user has no saved credential)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=

# Server
PORT=3001
NODE_ENV=development
