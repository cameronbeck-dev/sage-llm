NODE_ENV=development
PORT=3001

# PostgreSQL connection string (local or Heroku Postgres)
DATABASE_URL=postgresql://localhost:5432/sage

# Session secret — must be 32+ random bytes in production
SESSION_SECRET=dev-secret-change-in-production-use-32plus-bytes

# ─── Encryption Key (REQUIRED) ────────────────────────────────────────────────
# AES-256-GCM key for encrypting API credentials at rest.
# MUST be provided via a secrets manager in production:
#   - Heroku:  Settings → Config Vars → Reveal Config Vars → add SAGE_ENC_KEY
#   - AWS:     Secrets Manager → store as plaintext string
#   - Render:  Environment Variables → add from Secret File
#
# Generate a secure key (64 hex chars = 32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAGE_ENC_KEY=

# Gates the wiki rebuild code paths (Phase 1+). Keep false until wiki-migration is ready.
SAGE_WIKI_ENABLED=false

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/github/callback

# Dev only: URL of the Vite dev server. Leave empty in production.
CLIENT_URL=http://localhost:5173

# Defaults
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini

# ─── Sentry (optional) ────────────────────────────────────────────────────────
# Leave empty to disable error reporting (safe for dev/self-hosted).
SENTRY_DSN=
VITE_SENTRY_DSN=

# Storage: BYTEA in Postgres (production) or local disk (dev). No configuration required.

# ─── Web Tools (SearXNG) ──────────────────────────────────────────────────────
# URL of the SearXNG instance reachable from the server process.
# Default (commented out) is http://localhost:8080 — correct for host-run dev where
# only SearXNG is in docker. If you containerize the server too, override to
# http://searxng:8080 to use the docker-compose service name.
# SEARXNG_URL=http://localhost:8080

# Secret key for SearXNG. Generate: openssl rand -hex 32
SEARXNG_SECRET_KEY=changeme

# web_fetch settings (optional — defaults shown)
# WEB_FETCH_USER_AGENT=Sage/1.0 (+https://sage.local)
# WEB_FETCH_TIMEOUT_MS=10000
# WEB_FETCH_MAX_BYTES=5000000
