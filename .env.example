NODE_ENV=development
PORT=3001

# PostgreSQL connection string (local or Heroku Postgres)
DATABASE_URL=postgresql://localhost:5432/sage

# Session secret — must be 32+ random bytes in production
SESSION_SECRET=dev-secret-change-in-production-use-32plus-bytes

# ─── Encryption Key (REQUIRED) ────────────────────────────────────────────────
# AES-256-GCM key for encrypting API credentials at rest.
# MUST be provided via a secrets manager in production:
#   - Heroku:  Settings → Config Vars → Reveal Config Vars → add SAGE_ENC_KEY
#   - AWS:     Secrets Manager → store as plaintext string
#   - Render:  Environment Variables → add from Secret File
#
# Generate a secure key (64 hex chars = 32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAGE_ENC_KEY=

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/github/callback

# Dev only: URL of the Vite dev server. Leave empty in production.
CLIENT_URL=http://localhost:5173

# Defaults
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini